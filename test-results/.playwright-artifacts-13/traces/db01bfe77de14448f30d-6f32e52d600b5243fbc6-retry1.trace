round: #f1f5f9;\n      }\n      ::-webkit-scrollbar-thumb {\n        background: #cbd5e1;\n        border-radius: 4px;\n      }\n      ::-webkit-scrollbar-thumb:hover {\n        background: #94a3b8;\n      }\n\n      /* Thin scrollbar for sidebar */\n      .scrollbar-thin::-webkit-scrollbar {\n        width: 4px;\n      }\n      .scrollbar-thin::-webkit-scrollbar-track {\n        background: transparent;\n      }\n      .scrollbar-thin::-webkit-scrollbar-thumb {\n        background: #d1d5db;\n        border-radius: 2px;\n      }\n      .scrollbar-thin::-webkit-scrollbar-thumb:hover {\n        background: #9ca3af;\n      }\n\n      /* Dark Mode Overrides */\n      .dark body {\n        background-color: #000000; /* Pure Black */\n        color: #e2e8f0; /* Slate 200 */\n      }\n      .dark ::-webkit-scrollbar-track {\n        background: #050505;\n      }\n      .dark ::-webkit-scrollbar-thumb {\n        background: #262626;\n      }\n      .dark ::-webkit-scrollbar-thumb:hover {\n        background: #404040;\n      }\n\n      /* Dark mode thin scrollbar for sidebar */\n      .dark .scrollbar-thin::-webkit-scrollbar-thumb {\n        background: #374151;\n      }\n      .dark .scrollbar-thin::-webkit-scrollbar-thumb:hover {\n        background: #4b5563;\n      }\n\n      /* Animation utilities */\n      .animate-fadeIn {\n        animation: fadeIn 0.3s ease-out;\n      }\n      @keyframes fadeIn {\n        from { opacity: 0; transform: translateY(5px); }\n        to { opacity: 1; transform: translateY(0); }\n      }\n\n      /* Ripple effect for sidebar buttons */\n      @keyframes ripple {\n        0% {\n          transform: scale(0);\n          opacity: 1;\n        }\n        100% {\n          transform: scale(2);\n          opacity: 0;\n        }\n      }\n      .ripple-effect {\n        animation: ripple 0.6s ease-out;\n      }\n\n      /* Pulse animation for notifications */\n      @keyframes pulse-subtle {\n        0%, 100% {\n          opacity: 1;\n          transform: scale(1);\n        }\n        50% {\n          opacity: 0.8;\n          transform: scale(1.05);\n        }\n      }\n      .animate-pulse-subtle {\n        animation: pulse-subtle 2s ease-in-out infinite;\n      }\n\n      /* Slide in from left for sidebar expansion */\n      @keyframes slideInLeft {\n        from {\n          opacity: 0;\n          transform: translateX(-10px);\n        }\n        to {\n          opacity: 1;\n          transform: translateX(0);\n        }\n      }\n      .animate-slideInLeft {\n        animation: slideInLeft 0.2s ease-out;\n      }\n\n      /* Smooth scale hover effect */\n      .hover-scale {\n        transition: transform 0.2s ease-in-out;\n      }\n      .hover-scale:hover {\n        transform: scale(1.05);\n      }\n\n      /* Glassmorphism effect */\n      .glass-effect {\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n      }\n\n      /* Enhanced Glassmorphism for modern cards */\n      .glass-card {\n        background: rgba(255, 255, 255, 0.7);\n        backdrop-filter: blur(20px);\n        -webkit-backdrop-filter: blur(20px);\n        border: 1px solid rgba(255, 255, 255, 0.5);\n      }\n      .dark .glass-card {\n        background: rgba(15, 23, 42, 0.6);\n        border: 1px solid rgba(255, 255, 255, 0.05);\n      }\n\n      /* Clip path for pipeline headers */\n      .clip-path-chevron {\n        clip-path: polygon(0% 0%, 95% 0%, 100% 50%, 95% 100%, 0% 100%, 5% 50%);\n      }\n      /* First item needs straight left edge */\n      .clip-path-chevron:first-child {\n        clip-path: polygon(0% 0%, 95% 0%, 100% 50%, 95% 100%, 0% 100%);\n      }\n\n      /* Slide In Up Animation */\n      @keyframes slideInUp {\n        from {\n          opacity: 0;\n          transform: translateY(20px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n      .animate-slideInUp {\n        animation: slideInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n      }\n\n      /* Slide In Right Animation */\n      @keyframes slideInRight {\n        from {\n          opacity: 0;\n          transform: translateX(-20px);\n        }\n        to {\n          opacity: 1;\n          transform: translateX(0);\n        }\n      }\n      .animate-slideInRight {\n        animation: slideInRight 0.4s ease-out forwards;\n      }\n\n      /* Shimmer Effect for Loading */\n      @keyframes shimmer {\n        0% { background-position: -200% 0; }\n        100% { background-position: 200% 0; }\n      }\n      .animate-shimmer {\n        background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 100%);\n        background-size: 200% 100%;\n        animation: shimmer 1.5s infinite;\n      }\n      \n      /* Count Up Animation (simulated with opacity/transform for now) */\n      @keyframes countUp {\n        from {\n          opacity: 0;\n          transform: translateY(10px);\n        }\n        to {\n          opacity: 1;\n          transform: translateY(0);\n        }\n      }\n      .animate-countUp {\n        animation: countUp 0.8s ease-out forwards;\n      }\n\n      /* Soft Badge Glow */\n      .badge-glow {\n        box-shadow: 0 0 10px rgba(15, 82, 152, 0.15);\n      }\n      .dark .badge-glow {\n        box-shadow: 0 0 15px rgba(15, 82, 152, 0.3);\n      }\n\n      /* Custom loading animation */\n      .custom-loading-spinner {\n        --square: 26px;\n        --offset: 30px;\n        --duration: 2.4s;\n        --delay: 0.2s;\n        --timing-function: ease-in-out;\n        --in-duration: 0.4s;\n        --in-delay: 0.1s;\n        --in-timing-function: ease-out;\n        width: calc(3 * var(--offset) + var(--square));\n        height: calc(2 * var(--offset) + var(--square));\n        position: relative;\n      }\n\n      .custom-loading-square {\n        display: inline-block;\n        background: darkorange;\n        border: none;\n        border-radius: 2px;\n   